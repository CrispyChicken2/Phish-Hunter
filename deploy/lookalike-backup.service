[Unit]
Description=Daily snapshot of the database and the labelled dataset to S3
After=network-online.target
Wants=network-online.target

[Service]
# One pass, then exit. The bucket name comes from a drop-in written on the instance.
Type=oneshot
User=lookalike
Group=lookalike
WorkingDirectory=/opt/lookalike-hunter
Environment=LH_PROFILE=aws
Environment=AWS_REGION=eu-north-1
# JSON log lines go to a file the CloudWatch agent reads (P1.9).
StandardError=append:/var/log/lookalike-hunter/backup.log
ExecStart=/opt/lookalike-hunter/.venv/bin/lookalike-hunter backup
