__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
data/*
!data/.gitkeep
# Feed-derived sites: the feed's terms do not allow redistribution (docs/feed-data.md).
datasets/feed/
.env
*.duckdb
*.duckdb.wal
# Machine-specific: TLS-intercepting proxy / antivirus root CA, see README.
# The directory is tracked (the Dockerfile copies it); its certificates are not.
docker/local-ca/*
!docker/local-ca/.gitkeep
docker-compose.override.yml
# Terraform: state records the AWS account and the budget e-mail, and a local
# variables file holds the e-mail itself. None of it is committed.
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
*.tfvars
crash.log
